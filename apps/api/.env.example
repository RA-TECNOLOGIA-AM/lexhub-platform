SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: chave secreta server-side (ignora RLS). NUNCA expor no frontend.
SUPABASE_SECRET_KEY=
# Só se o projeto ainda assina tokens com o segredo JWT legado (HS256).
# Projetos novos usam chaves assimétricas (JWKS) e deixam isto vazio.
SUPABASE_JWT_SECRET=
# Postgres direto (Supabase > Connect > Transaction pooler). Usado para checar acesso
# (app_private.dashboard_scope) e gravar auditoria. Vazio = rotas de dashboard dão 503.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
