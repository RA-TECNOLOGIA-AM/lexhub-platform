SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: chave secreta server-side (ignora RLS). NUNCA expor no frontend.
SUPABASE_SECRET_KEY=
# Nome da v1 para a mesma chave (service_role); usada se SUPABASE_SECRET_KEY estiver vazia.
SUPABASE_SERVICE_ROLE_KEY=
WEB_BASE_URL=http://localhost:5173
# Só se o projeto ainda assina tokens com o segredo JWT legado (HS256).
# Projetos novos usam chaves assimétricas (JWKS) e deixam isto vazio.
SUPABASE_JWT_SECRET=
# Postgres direto (Supabase > Connect > Transaction pooler). Usado para checar acesso
# (app_private.dashboard_scope) e gravar auditoria. Vazio = rotas de dashboard dão 503.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
# Logs do terminal: DEBUG | INFO (padrão) | WARNING | ERROR. NO_COLOR=1 tira as cores.
# LOG_LEVEL=INFO

# --- Bancos de origem: MESMOS NOMES do .env da v1 (api_dashboards) ---
# Cada banco: DB_<NOME>_URL (tem prioridade) OU as variáveis separadas.
# Banco sem variáveis fica desligado (GET /health/sources mostra "off").
# Toda sessão é só leitura; a API nunca escreve nestes bancos.

# Banco NG
# DB_NG_URL=postgresql://usuario:senha@host:5432/operacao_ng
DB_NG_NAME=
DB_NG_USER=
DB_NG_PASSWORD=
DB_NG_HOST=
DB_NG_PORT=5432

# Banco LAADV
DB_LAADV_NAME=
DB_LAADV_USER=
DB_LAADV_PASSWORD=
DB_LAADV_HOST=
DB_LAADV_PORT=5432

# Banco LEXFLOW (Supabase; use o pooler)
# DB_LEXFLOW_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_LEXFLOW_NAME=
DB_LEXFLOW_USER=
DB_LEXFLOW_PASSWORD=
DB_LEXFLOW_HOST=
DB_LEXFLOW_PORT=5432

# Planilhas do Google: o link fica cifrado no Supabase (Conectar fonte), não aqui. As antigas
# (GOOGLE_SHEETS_URL_FINANCEIRO_NG/LA) foram para o banco com scripts/migrar_planilhas_env.py.

# Conectar fonte pela tela (banco próprio da operação e planilha publicada; app/secret_box.py).
# Chave AES-256 (base64 de 32 bytes) que cifra a senha do banco e o link da planilha no Supabase.
# Gerar (PowerShell, em apps/api):
#   .\.venv\Scripts\python.exe -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Vazia = só LexPre/LexFlow pela tela. Guardar com cuidado: trocar a chave obriga a salvar as senhas de novo.
SOURCE_SECRET_KEY=
# IP de saída da API, que a tela pede para a operação liberar no firewall do banco (vazio = não mostra).
SOURCE_EGRESS_IP=
# Só desenvolvimento: deixa conectar em banco de rede interna (localhost, 10.x...). Produção: false.
SOURCE_ALLOW_PRIVATE_HOSTS=false

# Banco LEXPRE (Supabase; o host direto db.* é só IPv6 e falha no WSL: use o pooler)
DB_LEXPRE_NAME=
DB_LEXPRE_USER=
DB_LEXPRE_PASSWORD=
DB_LEXPRE_HOST=
DB_LEXPRE_PORT=5432

# Pool e limites (opcionais; os padrões são os da v1)
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME=90
# DB_POOL_COMMAND_TIMEOUT=300
# DB_POOL_ACQUIRE_TIMEOUT=120
# Tempo limite para abrir cada conexão (s). Banco que não responde: a API sobe mesmo assim e reconecta sozinha.
# DB_CONNECT_TIMEOUT=10

# Banco da plataforma (DATABASE_URL): tempo limite para abrir conexão (s), conexões mantidas
# abertas e intervalo do teste que as mantém quentes (s). Ver app/platform_db.py.
# PLATFORM_DB_CONNECT_TIMEOUT=30
# PLATFORM_DB_POOL_MIN_SIZE=2
# PLATFORM_DB_POOL_MAX_SIZE=10
# PLATFORM_DB_KEEPALIVE_INTERVAL=60
# DB_POOL_MAX_QUERIES=10000
# DB_QUERY_CONCURRENCY_NG=2
# DB_QUERY_CONCURRENCY_LAADV=2
# DB_QUERY_CONCURRENCY_LEXFLOW=4
# DB_QUERY_CONCURRENCY_LEXPRE=4

# --- LexFlow e o egress do Supabase (ver README, "LexFlow e o egress do Supabase") ---
# Rodando a API local ligada ao LexFlow de produção, cada busca sai do Supabase e é cobrada.
# SOURCE_CACHE_WARM_SKIP=lexflow
# SOURCE_CACHE_TTL_LEXFLOW=900
# SOURCE_CACHE_PROBE=lexflow
# SOURCE_UNIT_SCOPE=false  # true depois do conferir_recorte_unidade.py dar tudo IGUAL

# --- Redis: cache compartilhado (L2), MESMOS NOMES da v1 ---
# Desligado = cache só na memória do processo. Ligado e fora do ar = a API segue (cai no banco).
# Local: docker run -d --name lexhub-redis -p 6379:6379 redis:8-alpine
# CACHE_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_TTL_HEAVY=600
# CACHE_TTL_DEFAULT=300
# CACHE_KEY_PREFIX=lexhub_platform:
# REDIS_SOCKET_TIMEOUT=2
# REDIS_RETRY_AFTER=30
