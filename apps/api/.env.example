SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: chave secreta server-side (ignora RLS). NUNCA expor no frontend.
SUPABASE_SECRET_KEY=
# Nome da v1 para a mesma chave (service_role); usada se SUPABASE_SECRET_KEY estiver vazia.
SUPABASE_SERVICE_ROLE_KEY=
# Só se o projeto ainda assina tokens com o segredo JWT legado (HS256).
# Projetos novos usam chaves assimétricas (JWKS) e deixam isto vazio.
SUPABASE_JWT_SECRET=
# Postgres direto (Supabase > Connect > Transaction pooler). Usado para checar acesso
# (app_private.dashboard_scope) e gravar auditoria. Vazio = rotas de dashboard dão 503.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173

# --- Bancos de origem: MESMOS NOMES do .env da v1 (api_dashboards) ---
# Cada banco: DB_<NOME>_URL (tem prioridade) OU as variáveis separadas.
# Banco sem variáveis fica desligado (GET /health/sources mostra "off").
# Toda sessão é só leitura; a API nunca escreve nestes bancos.

# Banco NG
# DB_NG_URL=postgresql://usuario:senha@host:5432/operacao_ng
DB_NG_NAME=
DB_NG_USER=
DB_NG_PASSWORD=
DB_NG_HOST=
DB_NG_PORT=5432

# Banco LAADV
DB_LAADV_NAME=
DB_LAADV_USER=
DB_LAADV_PASSWORD=
DB_LAADV_HOST=
DB_LAADV_PORT=5432

# Banco LEXFLOW (Supabase; use o pooler)
# DB_LEXFLOW_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_LEXFLOW_NAME=
DB_LEXFLOW_USER=
DB_LEXFLOW_PASSWORD=
DB_LEXFLOW_HOST=
DB_LEXFLOW_PORT=5432

# Banco LEXPRE (Supabase; o host direto db.* é só IPv6 e falha no WSL: use o pooler)
DB_LEXPRE_NAME=
DB_LEXPRE_USER=
DB_LEXPRE_PASSWORD=
DB_LEXPRE_HOST=
DB_LEXPRE_PORT=5432

# Pool e limites (opcionais; os padrões são os da v1)
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME=90
# DB_POOL_COMMAND_TIMEOUT=300
# DB_POOL_ACQUIRE_TIMEOUT=120
# DB_POOL_MAX_QUERIES=10000
# DB_QUERY_CONCURRENCY_NG=2
# DB_QUERY_CONCURRENCY_LAADV=2
# DB_QUERY_CONCURRENCY_LEXFLOW=4
# DB_QUERY_CONCURRENCY_LEXPRE=4
