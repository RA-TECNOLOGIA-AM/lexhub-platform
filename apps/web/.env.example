# Copie para .env.local (não versionado). Mesmos nomes do .env do front da v1 (LexHub).
# Tudo que começa com VITE_ vai para o navegador: NUNCA coloque senha de banco ou
# service_role aqui. Dados operacionais vêm pela API; algumas operações usam RPC autenticada no Supabase.

# mock = dados fictícios de src/services/mock/ (não precisa de API nem banco).
# api  = login pelo Supabase Auth + dados pela API V2.
VITE_DATA_SOURCE=mock

# API V2 (apps/api). Local: http://localhost:8000
VITE_BASE_API_URL=http://localhost:8000

# Supabase Auth — só login (Supabase > Project Settings > API). A anon key é pública por natureza.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# URL do front (redirect do e-mail de recuperação de senha)
VITE_SITE_URL=http://localhost:5173

# Bucket de avatar (Storage)
# VITE_SUPABASE_AVATAR_BUCKET=lexhub-midias
